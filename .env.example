# Signs Bug Hunt share links (HMAC). Required in production. At least 32 random characters: openssl rand -base64 48
SHARE_SECRET=
# Optional: id of the current key, and the previous secret during a rotation.
SHARE_KID=
SHARE_SECRET_PREV=

# Optional analytics (PostHog free tier, anonymous, cookieless). Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
